		{
			"name": "My Levels (capture first uuid)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"try {",
							"  const json = pm.response.json();",
							"  const arr = json && json.data;",
							"  if (Array.isArray(arr) && arr.length > 0 && arr[0].uuid) {",
							"    pm.collectionVariables.set('levelUuid', arr[0].uuid);",
							"  }",
							"} catch (e) {}"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{jwt}}"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/api/levels/my-levels",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"levels",
						"my-levels"
					]
				}
			},
			"response": []
		},
