{
  "kind": "collectionType",
  "collectionName": "levels",
  "info": {
    "singularName": "level",
    "pluralName": "levels",
    "displayName": "Levels"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "uid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "user_game_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-game-history.user-game-history",
      "mappedBy": "level"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "puzzleImage": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "difficulty": {
      "type": "enumeration",
      "enum": [
        "easy",
        "easy2",
        "medium",
        "medium2",
        "hard",
        "hard2"
      ]
    },
    "password": {
      "type": "text",
      "private": true
    },
    "user_levels": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-level.user-level",
      "mappedBy": "level"
    },
    "date": {
      "type": "date"
    },
    "isActive": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
