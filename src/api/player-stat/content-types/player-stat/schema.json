{
  "kind": "collectionType",
  "collectionName": "player_stats",
  "info": {
    "singularName": "player-stat",
    "pluralName": "player-stats",
    "displayName": "PlayerStats"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "uid"
    },
    "score": {
      "type": "integer",
      "default": 0
    },
    "highestScore": {
      "type": "integer",
      "default": 0
    },
    "xp": {
      "type": "integer",
      "default": 0
    },
    "gamesPlayed": {
      "type": "integer",
      "default": 0
    },
    "gamesWon": {
      "type": "integer",
      "default": 0
    },
    "gamesLost": {
      "type": "integer",
      "default": 0
    },
    "winRate": {
      "type": "float",
      "default": 0
    },
    "totalPlayTime": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "averageSessionTime": {
      "type": "float",
      "default": 0
    },
    "totalSessions": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "lastLoginAt": {
      "type": "datetime"
    },
    "lastPlayedAt": {
      "type": "datetime"
    },
    "currentStreak": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "longestStreak": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "lastStreakDate": {
      "type": "date"
    },
    "coinsEarned": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "coinsSpent": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "coins": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "required": true
    },
    "tickets": {
      "type": "integer",
      "min": 0,
      "default": 0,
      "required": true
    },
    "ticketsEarned": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "ticketsSpent": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "player_stat"
    },
    "user_sessions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-session.user-session",
      "mappedBy": "player_stat"
    }
  }
}
