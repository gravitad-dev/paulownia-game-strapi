{
  "kind": "collectionType",
  "collectionName": "reward_claims",
  "info": {
    "singularName": "reward-claim",
    "pluralName": "reward-claims",
    "displayName": "RewardClaim",
    "description": "Claims for consumable rewards that need to be processed by admin"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "uid"
    },
    "claimCode": {
      "type": "string",
      "maxLength": 20,
      "required": true,
      "unique": true
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "reward_claims"
    },
    "user_reward": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::user-reward.user-reward",
      "inversedBy": "reward_claim"
    },
    "guardian": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::guardiand.guardiand"
    },
    "fullName": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 20
    },
    "address": {
      "type": "text",
      "maxLength": 500
    },
    "city": {
      "type": "string",
      "maxLength": 100
    },
    "zipCode": {
      "type": "string",
      "maxLength": 20
    },
    "country": {
      "type": "string",
      "maxLength": 100
    },
    "additionalNotes": {
      "type": "text",
      "maxLength": 1000
    },
    "requiresIdentityVerification": {
      "type": "boolean",
      "default": false
    },
    "isMinor": {
      "type": "boolean",
      "default": false
    },
    "birthDate": {
      "type": "date"
    },
    "identityDocumentType": {
      "type": "enumeration",
      "enum": ["dni", "passport", "id_card", "other"]
    },
    "identityDocumentNumber": {
      "type": "string",
      "maxLength": 30,
      "private": true
    },
    "identityDocumentFront": {
      "type": "media",
      "private": true,
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "identityDocumentBack": {
      "type": "media",
      "private": true,
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "guardianDocumentFront": {
      "type": "media",
      "private": true,
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "guardianDocumentBack": {
      "type": "media",
      "private": true,
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "guardianEmailConfirmed": {
      "type": "boolean",
      "default": false
    },
    "guardianEmailConfirmedAt": {
      "type": "datetime"
    },
    "guardianConfirmationToken": {
      "type": "string",
      "private": true
    },
    "guardianResendCount": {
      "type": "integer",
      "default": 0
    },
    "claimStatus": {
      "type": "enumeration",
      "required": true,
      "default": "pending",
      "enum": ["pending", "processing", "delivered", "rejected", "cancelled"]
    },
    "verificationAttempts": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "rewardSnapshot": {
      "type": "json"
    },
    "processedAt": {
      "type": "datetime"
    },
    "processedBy": {
      "type": "string",
      "maxLength": 100,
      "private": true
    },
    "processedByName": {
      "type": "string",
      "maxLength": 100,
      "private": true
    },
    "adminNotes": {
      "type": "text",
      "maxLength": 2000
    },
    "rejectionReason": {
      "type": "text",
      "maxLength": 1000
    },
    "trackingNumber": {
      "type": "string",
      "maxLength": 100
    },
    "consentAcceptedAt": {
      "type": "datetime"
    },
    "termsAccepted": {
      "type": "boolean",
      "default": false
    },
    "dataProcessingAccepted": {
      "type": "boolean",
      "default": false
    }
  }
}
