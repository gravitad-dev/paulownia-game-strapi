{
  "kind": "collectionType",
  "collectionName": "user_sessions",
  "info": {
    "singularName": "user-session",
    "pluralName": "user-sessions",
    "displayName": "UserSession",
    "description": "Tracks user game sessions for analytics"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "uid"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_sessions"
    },
    "player_stat": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::player-stat.player-stat",
      "inversedBy": "user_sessions"
    },
    "sessionType": {
      "type": "enumeration",
      "enum": ["login", "game", "idle"],
      "default": "login"
    },
    "startedAt": {
      "type": "datetime",
      "required": true
    },
    "endedAt": {
      "type": "datetime"
    },
    "duration": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "lastHeartbeat": {
      "type": "datetime"
    },
    "gamesPlayedInSession": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "scoreInSession": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "coinsEarnedInSession": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "deviceInfo": {
      "type": "json"
    },
    "ipAddress": {
      "type": "string",
      "private": true
    }
  }
}
