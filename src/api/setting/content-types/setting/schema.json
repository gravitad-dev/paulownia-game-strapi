{
  "kind": "singleType",
  "collectionName": "settings",
  "info": {
    "singularName": "setting",
    "pluralName": "settings",
    "displayName": "Settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "rouletteIsActive": {
      "type": "boolean",
      "private": true,
      "default": true
    },
    "coinsPerTicket": {
      "type": "integer",
      "min": 1,
      "default": 1000
    },
    "exchangeLimitEnabled": {
      "type": "boolean",
      "default": true
    },
    "exchangeLimitTickets": {
      "type": "integer",
      "min": 0,
      "default": 10
    },
    "exchangeLimitPeriod": {
      "type": "enumeration",
      "enum": ["daily", "monthly", "yearly"],
      "default": "monthly"
    }
  }
}
