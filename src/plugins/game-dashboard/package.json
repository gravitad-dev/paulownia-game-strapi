{
  "name": "game-dashboard",
  "version": "1.0.0",
  "description": "Dashboard de estadísticas del juego para Strapi Admin",
  "strapi": {
    "name": "game-dashboard",
    "description": "Dashboard de estadísticas del juego",
    "kind": "plugin"
  },
  "exports": {
    "./strapi-admin": {
      "source": "./admin/src/index.tsx",
      "import": "./admin/src/index.tsx",
      "require": "./admin/src/index.tsx",
      "default": "./admin/src/index.tsx"
    },
    "./strapi-server": {
      "source": "./server/src/index.ts",
      "require": "./server/src/index.ts",
      "default": "./server/src/index.ts"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  }
}
